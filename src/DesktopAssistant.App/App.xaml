<Application x:Class="DesktopAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <SolidColorBrush x:Key="Accent" Color="#4C8DF6" />
    <SolidColorBrush x:Key="AccentHover" Color="#6BA1FF" />
    <SolidColorBrush x:Key="Surface" Color="#1E1F22" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#2A2B2F" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#34363B" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEDEF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3A7AF" />
    <SolidColorBrush x:Key="Divider" Color="#3A3C41" />
    <LinearGradientBrush x:Key="GeminiGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4C8DF6" Offset="0" />
      <GradientStop Color="#9B72F2" Offset="0.55" />
      <GradientStop Color="#D96570" Offset="1" />
    </LinearGradientBrush>

    <!-- Rounded flat button used across the app -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>
  </Application.Resources>
</Application>
