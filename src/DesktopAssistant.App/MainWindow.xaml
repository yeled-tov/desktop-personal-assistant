<Window x:Class="DesktopAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="עוזר אישי למחשב" Width="510" Height="680" MinWidth="420" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FlowDirection="RightToLeft">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock x:Name="TitleText" Text="עוזר אישי למחשב" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="מוכן · Ctrl + Alt + Space" Foreground="#667085" Margin="0,3,0,0"/></StackPanel><Button x:Name="SettingsButton" DockPanel.Dock="Left" Content="הגדרות" Click="Settings_Click"/></DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12"><ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="History"/></ScrollViewer></Border>
    <Border Grid.Row="2" Margin="0,12,0,0" Background="White" CornerRadius="12" Padding="8"><DockPanel><Button x:Name="SendButton" DockPanel.Dock="Left" Content="שלח" Click="Send_Click"/><Button x:Name="StopButton" DockPanel.Dock="Left" Content="עצור" Background="#D92D20" Click="Stop_Click"/><Button DockPanel.Dock="Left" Content="🎙" ToolTip="זיהוי דיבור עדיין לא זמין" Click="Voice_Click"/><TextBox x:Name="InputBox" BorderThickness="0" FontSize="15" Padding="8" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" FlowDirection="RightToLeft"/></DockPanel></Border>
    <DockPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock x:Name="OfflineNote" Text="פעולות מקומיות פועלות גם ללא חיבור AI." Foreground="#667085" VerticalAlignment="Center"/><Button x:Name="TranslateButton" DockPanel.Dock="Left" Content="תרגם מסך" Click="Translate_Click"/></DockPanel>
  </Grid>
</Window>
